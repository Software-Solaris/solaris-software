# Doxyfile for Solaris Software

PROJECT_NAME           = "Solaris Software"
PROJECT_LOGO           = doxygen/assets/logo.png

# Input - the narrative pages (doxygen/pages) plus the firmware sources.
INPUT                  = doxygen/pages \
                         solaris-v2/main \
                         solaris-v2/spp
FILE_PATTERNS          = *.c *.h *.dox *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */tests/* */.cache/* */README.md */LICENSE.md
IMAGE_PATH             = doxygen/assets
USE_MDFILE_AS_MAINPAGE = doxygen/pages/index.md
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3

# Output
OUTPUT_DIRECTORY       = doc
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_LATEX         = NO
SEARCHENGINE           = YES

# HTML theme - Doxygen's own built-in template, no third-party CSS/JS, no
# custom hue/sat/gamma tuning either — just its native dark palette (added
# in Doxygen 1.9.5+) with its own default colors. doxygen/tweaks.css is two
# small fixes on top (bigger base text, hide a hardcoded-color badge), not a
# redesign. doxygen/header.html is Doxygen's own stock header (extracted
# with `doxygen -w html`), with a single change: the logo links to "/".
HTML_COLORSTYLE        = DARK
GENERATE_TREEVIEW      = YES
HTML_EXTRA_STYLESHEET  = doxygen/tweaks.css
HTML_HEADER            = doxygen/header.html

# Extraction
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES
EXTRACT_LOCAL_CLASSES  = YES

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

# Diagrams
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DOT_GRAPH_MAX_NODES    = 100
MAX_DOT_GRAPH_DEPTH    = 0
DOT_MULTI_TARGETS      = YES

# Documentation quality
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

# Misc
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
SORT_GROUP_NAMES       = NO
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = YES
SHOW_INCLUDE_FILES     = YES
SHOW_GROUPED_MEMB_INC = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
QUIET                  = YES
WARNINGS               = YES
